# Copy to cloud/.env on each VM and fill in. cloud/.env is gitignored;
# never commit real credentials.
#
#   cp cloud/.env.example cloud/.env

# Address of the Central Base Station VM, as the stations reach it.
# Needed on BOTH machines: the central VM advertises it, the stations dial it.
#   - VMs on the same virtual network: use the central VM's PRIVATE IP.
#     Kafka then never needs to be exposed to the internet.
#   - VMs on separate networks: use its PUBLIC IP, and open 9092 to the
#     stations' address only.
CENTRAL_HOST=

# Aiven PostgreSQL connection details. Central VM only — the stations
# never talk to the database.
# Aiven requires TLS, hence sslmode=require.
DB_URL=jdbc:postgresql://<service>.aivencloud.com:<port>/weather_monitoring?sslmode=require
DB_USER=avnadmin
DB_PASSWORD=
