# Copy to cloud/.env on each VM and fill in. cloud/.env is gitignored;
# never commit real credentials.
#
#   cp cloud/.env.example cloud/.env

# Public IPv4 address (or Elastic IP) of the Central Base Station VM.
# Needed on BOTH machines: the central VM advertises it, the stations VM
# dials it.
CENTRAL_PUBLIC_IP=

# Aiven PostgreSQL connection details. Central VM only — the stations
# never talk to the database.
# Aiven requires TLS, hence sslmode=require.
DB_URL=jdbc:postgresql://<service>.aivencloud.com:<port>/weather_monitoring?sslmode=require
DB_USER=avnadmin
DB_PASSWORD=
